{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["bbe", "ingress-nginx"],
  "properties": {
    "bbe": {
      "type": "object",
      "properties": {
        "metallb": {
          "type": "object",
          "properties": {
            "blocky": {
              "type": "object",
              "properties": {
                "ipAddressPool": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The IP address for the Blocky DNS service, or a range such as 192.168.1.240-192.168.1.245"
                }
              },
              "required": ["ipAddressPool"]
            }
          },
          "required": ["blocky"]
        }
      },
      "required": ["metallb"]
    },
    "ingress-nginx": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "loadBalancerIP": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The IP address for the ingress load balancer, on the same network as your nodes"
                }
              },
              "required": ["loadBalancerIP"]
            }
          },
          "required": ["service"]
        }
      },
      "required": ["controller"]
    }
  }
}
