          "expr": "sum(rate(blocky_cache_hits_total{pod=~\"$pod\"}[$__rate_interval])) / (sum(rate(blocky_cache_hits_total{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(blocky_cache_misses_total{pod=~\"$pod\"}[$__rate_interval])))",
