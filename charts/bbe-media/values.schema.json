{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["bbe"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "bbe": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "description": "The domain the apps are named under, the same as bbe-networking's"
            },
            "sso": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "bbe": {
      "type": "object",
      "required": ["media", "admin"],
      "properties": {
        "media": {
          "type": "object",
          "required": ["nfs", "user"],
          "properties": {
            "jellyfin": {
              "type": "object",
              "properties": {
                "transcoding": {
                  "type": "object",
                  "properties": {
                    "allowCpu": { "type": "boolean", "description": "Whether Jellyfin may run without a GPU, transcoding on the CPU, when no node has one to give" },
                    "gpu": { "type": "string", "minLength": 1, "description": "The GPU resource Jellyfin asks for, such as gpu.intel.com/i915" },
                    "acceleration": { "type": "string", "enum": ["qsv", "vaapi"], "description": "How Jellyfin uses the GPU: qsv (Intel Quick Sync) or vaapi" },
                    "decodingCodecs": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "enum": ["h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9", "av1"] },
                      "description": "The codecs the GPU decodes"
                    },
                    "tenBitDecoding": { "type": "boolean" },
                    "hevcEncoding": { "type": "boolean" },
                    "av1Encoding": { "type": "boolean" },
                    "tonemapping": { "type": "boolean", "description": "Whether to tone-map HDR to SDR with OpenCL" }
                  }
                }
              }
            },
            "bazarr": {
              "type": "object",
              "properties": {
                "providers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$"
                      }
                    }
                  }
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  }
                }
              }
            },
            "ingress": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "nfs": {
              "type": "object",
              "required": ["server", "path"],
              "properties": {
                "server": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The NFS server holding the media library, as a hostname or IP address"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/",
                  "description": "The exported path of the media library on the NFS server, such as /volume1/media"
                },
                "mountOptions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Mount options for the NFS share"
                }
              }
            },
            "size": {
              "type": "string",
              "minLength": 1,
              "description": "The size of the media library"
            },
            "prowlarr": {
              "type": "object",
              "properties": {
                "indexers": {
                  "type": "array",
                  "description": "The indexers Prowlarr searches, and shares with Sonarr and Radarr",
                  "items": {
                    "type": "object",
                    "required": ["name", "definition"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The indexer's name in Prowlarr"
                      },
                      "definition": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The Prowlarr definition the indexer is made from, such as internetarchive"
                      },
                      "fields": {
                        "type": "object",
                        "description": "The indexer's settings by field name"
                      },
                      "secretFields": {
                        "type": "object",
                        "description": "The key in the bbe-media-indexers secret of each credential, by field name",
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^[-._a-zA-Z0-9]+$"
                        }
                      }
                    }
                  }
                }
              }
            },
            "seeding": {
              "type": "object",
              "properties": {
                "maxRatio": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The ratio qBittorrent seeds every torrent to, or 0 for no limit"
                },
                "removeWhenDone": {
                  "type": "boolean",
                  "description": "Whether qBittorrent removes a torrent with its files once it reaches the ratio"
                }
              }
            },
            "flaresolverr": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether to run FlareSolverr for the indexers Cloudflare blocks"
                },
                "requestTimeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 180,
                  "description": "How long FlareSolverr may take to get past a challenge, in seconds"
                },
                "concurrency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "description": "How many challenges FlareSolverr gets past at once, each with its own Chromium"
                }
              }
            },
            "user": {
              "type": "object",
              "required": ["uid", "gid"],
              "description": "The NAS user the apps write the media library as",
              "properties": {
                "uid": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The user ID of the NAS user owning the media library share, as shown by `id <user>` on the NAS"
                },
                "gid": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The group ID of the NAS user owning the media library share, as shown by `id <user>` on the NAS"
                }
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "required": ["username"],
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "description": "The username for every app's web UI"
            }
          }
        },
        "setup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether to connect the apps to each other after every install and upgrade"
            },
            "readyTimeout": {
              "type": "integer",
              "minimum": 1,
              "description": "How long the setup waits for the apps to start, in seconds"
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0,
              "description": "How many times the setup is retried when an app couldn't be set up"
            },
            "retryDelay": {
              "type": "integer",
              "minimum": 0,
              "description": "How long a failed setup waits before it's retried, in seconds"
            }
          }
        }
      }
    }
  }
}
