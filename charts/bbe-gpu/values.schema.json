{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "bbe": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": "object",
          "properties": {
            "intel": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "sharedDevNum": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many pods may share one GPU at a time"
                }
              }
            }
          }
        }
      }
    }
  }
}
